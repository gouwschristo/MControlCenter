      <widget class="QWidget" name="debugTab">
       <attribute name="icon">
        <iconset theme="dialog-warning"/>
       </attribute>
       <attribute name="title">
        <string>Debug</string>
       </attribute>
       <layout class="QVBoxLayout" name="debugTabLayout">
        <property name="leftMargin">
         <number>16</number>
        </property>
        <property name="topMargin">
         <number>16</number>
        </property>
        <property name="rightMargin">
         <number>16</number>
        </property>
        <property name="bottomMargin">
         <number>16</number>
        </property>
        <property name="spacing">
         <number>14</number>
        </property>
        <item>
         <widget class="QGroupBox" name="debugWarningGroup">
          <property name="title">
           <string>Danger zone</string>
          </property>
          <layout class="QGridLayout" name="debugWarningLayout">
           <property name="leftMargin">
            <number>14</number>
           </property>
           <property name="topMargin">
            <number>14</number>
           </property>
           <property name="rightMargin">
            <number>14</number>
           </property>
           <property name="bottomMargin">
            <number>14</number>
           </property>
           <item row="0" column="0">
            <widget class="QLabel" name="label_10">
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Warning:&lt;/span&gt; writing the wrong values to the wrong EC addresses &lt;span style=&quot; font-weight:700;&quot;&gt;WILL BRICK YOUR DEVICE!&lt;/span&gt; Never write to EC memory without knowing how to perform a proper BIOS/EC reset. A reset might not fix a bricked device.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="rawEcGroup">
          <property name="title">
           <string>Raw EC access</string>
          </property>
          <property name="toolTip">
           <string>Read or write a single byte of EC memory. Intended for advanced debugging only.</string>
          </property>
          <layout class="QGridLayout" name="rawEcLayout">
           <property name="leftMargin">
            <number>14</number>
           </property>
           <property name="topMargin">
            <number>14</number>
           </property>
           <property name="rightMargin">
            <number>14</number>
           </property>
           <property name="bottomMargin">
            <number>14</number>
           </property>
           <property name="horizontalSpacing">
            <number>18</number>
           </property>
           <property name="verticalSpacing">
            <number>8</number>
           </property>
           <item row="0" column="0">
            <widget class="QLabel" name="label">
             <property name="text">
              <string>Address (hex):</string>
             </property>
             <property name="toolTip">
              <string>EC register address, for example 0x2E.</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLineEdit" name="addressEdit">
             <property name="toolTip">
              <string>Enter a hexadecimal EC address, for example 0x2E.</string>
             </property>
             <property name="placeholderText">
              <string>0x2E</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLabel" name="label_2">
             <property name="text">
              <string>Value (0–255):</string>
             </property>
             <property name="toolTip">
              <string>Byte value to write. Read Value fills this field.</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QSpinBox" name="ValueSpinBox">
             <property name="toolTip">
              <string>Byte value from 0 to 255.</string>
             </property>
             <property name="maximum">
              <number>255</number>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QPushButton" name="ReadValueButton">
             <property name="text">
              <string>Read value</string>
             </property>
             <property name="toolTip">
              <string>Read the byte at the entered address and show it in the Value field.</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QPushButton" name="WriteValueButton">
             <property name="text">
              <string>Write value</string>
             </property>
             <property name="toolTip">
              <string>Write the entered byte to the EC. This can damage the device; use only if you know the register.</string>
             </property>
            </widget>
           </item>
           <item row="3" column="0" colspan="2">
            <widget class="QLabel" name="rawEcHintLabel">
             <property name="text">
              <string>Reads and writes use the ec_sys debug interface. They are independent of the msi-ec-ng attributes used by the rest of the app.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="debugSpacer">
          <property name="orientation">
           <enum>Qt::Orientation::Vertical</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>10</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>
     </widget>
