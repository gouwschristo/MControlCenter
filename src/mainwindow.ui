        <item>
         <widget class="QGroupBox" name="keyboardBacklightGroup">
          <property name="title">
           <string>Keyboard backlight</string>
          </property>
          <property name="toolTip">
           <string>Control the keyboard backlight on, its behaviour and its brightness.</string>
          </property>
          <layout class="QGridLayout" name="keyboardBacklightLayout">
           <property name="leftMargin">
            <number>14</number>
           </property>
           <property name="topMargin">
            <number>14</number>
           </property>
           <property name="rightMargin">
            <number>14</number>
           </property>
           <property name="bottomMargin">
            <number>14</number>
           </property>
           <property name="horizontalSpacing">
            <number>18</number>
           </property>
           <property name="verticalSpacing">
            <number>10</number>
           </property>
           <item row="0" column="0" colspan="2">
            <widget class="QCheckBox" name="kbdBacklightEnableCheckBox">
             <property name="text">
              <string>Backlight on</string>
             </property>
             <property name="toolTip">
              <string>Turn the keyboard backlight on or off. Turning it off preserves the last brightness level.</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="keyboardBacklightLabel">
             <property name="text">
              <string>Mode:</string>
             </property>
             <property name="toolTip">
              <string>Choose whether the backlight stays on or dims after inactivity.</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QComboBox" name="keyboardBacklightModeComboBox">
             <property name="toolTip">
              <string>Always on keeps the backlight lit. Auto turn off dims it after 10 seconds without keyboard input.</string>
             </property>
             <item>
              <property name="text">
               <string>Always on</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Auto turn off in 10 sec</string>
              </property>
             </item>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="keyboardBrightnessLabel">
             <property name="text">
              <string>Brightness:</string>
             </property>
             <property name="toolTip">
              <string>Keyboard backlight level from 0 (dimmest) to 3 (brightest).</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <layout class="QHBoxLayout" name="keyboardBrightnessLayout">
             <property name="spacing">
              <number>10</number>
             </property>
             <item>
              <widget class="QSlider" name="keyboardBrightnessSlider">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                 <horstretch>0</horstretch>
                 <verstretch>0</verstretch>
                </sizepolicy>
               </property>
               <property name="toolTip">
                <string>Backlight level 0–3. Level 0 is the dimmest setting while the backlight is on; use the On checkbox to turn it off.</string>
               </property>
               <property name="maximum">
                <number>3</number>
               </property>
               <property name="pageStep">
                <number>1</number>
               </property>
               <property name="orientation">
                <enum>Qt::Orientation::Horizontal</enum>
               </property>
               <property name="tickPosition">
                <enum>QSlider::TickPosition::TicksBothSides</enum>
               </property>
               <property name="tickInterval">
                <number>1</number>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="keyboardBrightnessValueLabel">
               <property name="minimumSize">
                <size>
                 <width>24</width>
                 <height>0</height>
                </size>
               </property>
               <property name="font">
                <font>
                 <bold>true</bold>
                </font>
               </property>
               <property name="text">
                <string notr="true">0</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignmentFlag::AlignCenter</set>
               </property>
               <property name="toolTip">
                <string>Current keyboard backlight level (0–3).</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="3" column="1">
            <layout class="QHBoxLayout" name="keyboardTickLabels">
             <item>
              <widget class="QLabel" name="keyboardLevel0Label">
               <property name="text">
                <string>0 (dim)</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignVCenter</set>
               </property>
              </widget>
             </item>
             <item>
              <spacer name="keyboardTickSpacer">
               <property name="orientation">
                <enum>Qt::Orientation::Horizontal</enum>
               </property>
               <property name="sizeHint" stdset="0">
                <size>
                 <width>20</width>
                 <height>20</height>
                </size>
               </property>
              </spacer>
             </item>
             <item>
              <widget class="QLabel" name="keyboardLevel3Label">
               <property name="text">
                <string>3 (bright)</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignmentFlag::AlignRight|Qt::AlignmentFlag::AlignVCenter</set>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="4" column="0" colspan="2">
            <widget class="QLabel" name="keyboardHintLabel">
             <property name="text">
              <string>On/off and brightness are stored in the EC. The mode is stored in a separate EC bit and survives reboots.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="keyboardSpacer">
          <property name="orientation">
           <enum>Qt::Orientation::Vertical</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>10</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>
